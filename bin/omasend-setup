#!/usr/bin/env bash
#
# omasend-setup — install the omasend-engine binary for this plugin checkout.
#
# This script ships inside the plugin, so `omarchy plugin add` puts it on disk
# alongside the manifest and the engine source. It builds the engine from that
# source, so what you run is exactly the code you can read in this checkout —
# nothing is downloaded and there is no opaque binary to trust.
#
# Building needs Go. Without it the script stops and explains rather than
# quietly fetching a prebuilt binary; see OMASEND_ALLOW_PREBUILT below if you
# would rather have the release asset than the Go toolchain.
#
# It also makes sure the plugin's bar icon has a place in the bar, since an
# install that lost that entry cannot get it back with `omarchy plugin enable`
# alone (see ensure_bar_widget below).
#
# Usage:
#   bin/omasend-setup            place the bar icon, build and install the engine
#   bin/omasend-setup --check    report what is installed, change nothing
#
# Overrides:
#   BIN_DIR=~/bin                install somewhere other than ~/.local/bin
#   OMASEND_REPO=user/repo       download from a fork's releases
#   OMASEND_ALLOW_PREBUILT=1     opt in to the pinned release binary instead of
#                                building. The download is bounded, staged
#                                non-executable, and installed only if its
#                                SHA-256 matches the one committed in
#                                engine/SHA256SUMS at this commit — but a
#                                prebuilt binary cannot be audited from this
#                                tree, which is why it is off by default.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN_DIR="${BIN_DIR:-$HOME/.local/bin}"
BIN="$BIN_DIR/omasend-engine"
REPO="${OMASEND_REPO:-28allday/omasend-quattro}"
SUMS="$ROOT/engine/SHA256SUMS"
# Ceiling for the optional prebuilt download. The engine is ~7.5 MB; this is
# generous headroom for growth and still small enough that a hostile or
# misdirected response cannot fill the disk before the digest is checked.
MAX_ENGINE_BYTES=33554432   # 32 MiB

say() { printf '%s\n' "$*"; }
die() { printf 'omasend-setup: %s\n' "$*" >&2; exit 1; }

# Facts about this plugin come from its own manifest, so nothing here can drift
# from the code that was reviewed alongside it.
manifest_field() {
  field="$1"
  [ -f "$ROOT/manifest.json" ] || die "manifest.json not found in $ROOT"
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg f "$field" '.[$f] // empty' "$ROOT/manifest.json"
  else
    sed -n "s/.*\"$field\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" \
      "$ROOT/manifest.json" | head -1
  fi
}

pinned_version() { manifest_field version; }
plugin_id() { manifest_field id; }

# Which bar section the widget belongs in. The manifest is the source of truth;
# anything unexpected falls back to the right-hand section.
default_bar_section() {
  section=""
  if command -v jq >/dev/null 2>&1; then
    section="$(jq -r '.barWidget.defaultSection // empty' "$ROOT/manifest.json" 2>/dev/null || true)"
  else
    section="$(sed -n 's/.*"defaultSection"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "$ROOT/manifest.json" | head -1)"
  fi
  case "$section" in
    left | center | right) printf '%s\n' "$section" ;;
    *) printf 'right\n' ;;
  esac
}

omarchy_cmd() {
  if command -v omarchy >/dev/null 2>&1; then
    printf 'omarchy\n'
  elif [ -x /usr/share/omarchy/bin/omarchy ]; then
    printf '%s\n' /usr/share/omarchy/bin/omarchy
  fi
}

# What `omarchy plugin list` says about the widget: for a bar-widget plugin
# "enabled" means it has a place in the bar, which is exactly what we care
# about. "unknown" covers a shell that is not running to answer.
bar_state() {
  omarchy="$(omarchy_cmd)"
  [ -n "$omarchy" ] || { printf 'unknown\n'; return 0; }
  # `|| true`: under `set -e` a failing `plugin list` (no shell running to
  # answer) would otherwise abort the whole script from inside the command
  # substitution that calls this — silently, before the engine is installed.
  # "unknown" is exactly the answer that case is meant to produce.
  { "$omarchy" plugin list 2>/dev/null || true; } |
    awk -v id="$1" '$1 == id { print $2; found = 1 } END { if (!found) print "unknown" }'
}

# Put the paper-plane icon back in the bar.
#
# The icon is a bar-layout entry in shell.json, separate from the entry that
# makes the panel loadable — so the panel can work perfectly while no icon
# shows. The trap is that `omarchy plugin enable` places the widget only when
# the id appears nowhere in shell.json: opening the panel makes the plugin
# claim a plugins[] entry of its own, and from then on enable reports success
# and writes nothing. Disabling first clears that reference so the placement
# actually lands. A widget already sitting in the bar is left alone, so
# re-running this can't move an icon the user has positioned themselves.
ensure_bar_widget() {
  omarchy="$(omarchy_cmd)"
  [ -n "$omarchy" ] || return 0
  id="$(plugin_id)"
  [ -n "$id" ] || return 0

  state="$(bar_state "$id")"
  [ "$state" = "disabled" ] || return 0

  section="$(default_bar_section)"
  say "Placing the bar icon (shell.json has no bar entry for $id)…"
  "$omarchy" plugin disable "$id" >/dev/null 2>&1 || true
  if "$omarchy" plugin enable "$id" "$section" >/dev/null 2>&1; then
    say "Bar icon placed in the $section section."
  else
    say "Could not place the bar icon. Enable it from Setup > Plugins, or run:"
    say "  $omarchy plugin disable $id && $omarchy plugin enable $id $section"
  fi
}

asset_name() {
  case "$(uname -m)" in
    x86_64)  echo "omasend-engine-linux-amd64" ;;
    aarch64) echo "omasend-engine-linux-arm64" ;;
    *)       die "unsupported architecture $(uname -m) — install Go and re-run to build from source" ;;
  esac
}

if [ "${1:-}" = "--check" ]; then
  case "$(bar_state "$(plugin_id)")" in
    enabled)  say "bar icon: in the bar" ;;
    disabled) say "bar icon: not in the bar — re-run without --check to place it" ;;
    *)        say "bar icon: unknown (is omarchy-shell running?)" ;;
  esac
  if [ -x "$BIN" ]; then
    say "engine: $BIN"
    exit 0
  fi
  say "engine: not installed"
  exit 1
fi

# Do this before the engine work: it needs neither Go nor a network, so a box
# that cannot build still gets its icon back.
ensure_bar_widget

version="$(pinned_version)"
[ -n "$version" ] || die "could not read the plugin version from manifest.json"
mkdir -p "$BIN_DIR"

if command -v go >/dev/null 2>&1 && [ -f "$ROOT/go.mod" ]; then
  say "Building omasend-engine $version from source in $ROOT…"
  (cd "$ROOT" && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' \
    -o "$BIN.tmp" ./cmd/omasend-engine)
  chmod 755 "$BIN.tmp"
  mv "$BIN.tmp" "$BIN"
  say "Engine built and installed: $BIN"
  exit 0
fi

# No Go. Building is the only path that is auditable from this checkout, so
# stop here unless the user has explicitly chosen otherwise.
if [ "${OMASEND_ALLOW_PREBUILT:-}" != "1" ]; then
  die "Go is required to build the engine, and it is not installed.

The engine is built from the source in this checkout so that what runs is
exactly the code you can read here. Either install Go and re-run:

  sudo pacman -S go
  $0

or, if you would rather not install a toolchain, opt in to the prebuilt
release binary — pinned to v$version and checked against engine/SHA256SUMS,
but not something you can audit from this tree:

  OMASEND_ALLOW_PREBUILT=1 $0"
fi

say "Using the prebuilt release binary at your request (OMASEND_ALLOW_PREBUILT=1)."
asset="$(asset_name)"
url="https://github.com/$REPO/releases/download/v$version/$asset"

# The digest comes from this checkout, not from the release. A release asset is
# mutable — it can be replaced under a tag that already exists — so the only
# thing worth pinning against is the SHA-256 committed here, which is fixed for
# the commit a reviewer read and cannot change without a new commit.
[ -f "$SUMS" ] || die "engine/SHA256SUMS is missing — refusing to install an unverified binary"
want="$(awk -v a="$asset" '$2 == a || $2 == "*"a {print $1}' "$SUMS" | head -1)"
[ -n "$want" ] || die "no SHA-256 recorded for $asset in engine/SHA256SUMS"
case "$want" in
  [0-9a-f]*) [ "${#want}" -eq 64 ] || die "malformed SHA-256 for $asset in engine/SHA256SUMS" ;;
  *)         die "malformed SHA-256 for $asset in engine/SHA256SUMS" ;;
esac
command -v sha256sum >/dev/null 2>&1 || die "sha256sum not found — cannot verify the download"

say "Downloading pinned engine v$version ($asset)…"
# Staged unreadable-to-others and NON-EXECUTABLE: nothing that has not matched
# the pinned digest is ever executable, and the name is unpredictable so it
# cannot be pre-created by anything else sharing $BIN_DIR.
tmp="$(mktemp "$BIN_DIR/.omasend-engine.XXXXXXXXXX")" ||
  die "could not create a staging file in $BIN_DIR"
chmod 600 "$tmp"
trap 'rm -f "$tmp"' EXIT HUP INT TERM

# The ceiling is enforced DURING the transfer, not after it: --max-filesize
# only acts on a declared Content-Length, so the stream also runs through
# `head -c`, which stops writing whatever the headers claim.
if ! curl -fsSL --proto '=https' --tlsv1.2 --max-time 600 \
     --max-filesize "$MAX_ENGINE_BYTES" "$url" |
     head -c "$((MAX_ENGINE_BYTES + 1))" > "$tmp"; then
  die "download failed: $url"
fi
size="$(wc -c < "$tmp")"
[ "$size" -le "$MAX_ENGINE_BYTES" ] ||
  die "refusing $asset: larger than the $MAX_ENGINE_BYTES-byte ceiling — nothing was installed"

got="$(sha256sum "$tmp" | awk '{print $1}')"
if [ "$got" != "$want" ]; then
  die "checksum mismatch for $asset
  expected $want
  got      $got
The download does not match the checksum committed in this checkout — nothing
was installed. Report this, or install Go and re-run to build from source."
fi

# Only now, past the digest, does it become executable.
chmod 755 "$tmp"
mv "$tmp" "$BIN"
trap - EXIT HUP INT TERM
say "Engine installed and checksum-verified: $BIN"
